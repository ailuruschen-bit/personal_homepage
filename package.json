{
  "name": "personal-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node tools/art/check.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "art": "python3 tools/art/build.py && node tools/art/check.mjs",
    "art:check": "node tools/art/check.mjs",
    "art:preview": "python3 tools/art/preview.py",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
